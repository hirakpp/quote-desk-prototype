  "questionnaire": [
    {
      "id": "Q1",
      "gate": true,
      "text": "Is every vehicle you will place on our lanes fitted with GPS tracking that we can view live?"
    },
    {
      "id": "Q2",
      "gate": true,
      "text": "Do you carry transit insurance covering our goods up to Rs 50 lakh per consignment?"
    },
    {
      "id": "Q3",
      "gate": true,
      "text": "Do the vehicles hold a valid national permit for the full contract year?"
    },
    {
      "id": "Q4",
      "gate": false,
      "text": "How many vehicles do you own, and how many do you take from the market?"
    },
    {
      "id": "Q5",
      "gate": false,
      "text": "Do you accept payment 45 days from proof of delivery?"
    },
    {
      "id": "Q6",
      "gate": false,
      "text": "What do you charge for detention beyond 24 hours at loading or unloading?"
    },
    {
      "id": "Q7",
      "gate": false,
      "text": "How many days after delivery do you return the signed proof of delivery?"
    },
    {
      "id": "Q8",
